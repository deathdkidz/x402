# =====================================================
# x402 Facilitator - Environment Configuration
# =====================================================

# Server Configuration
SERVICE_NAME="x402 Facilitator"
SERVICE_DESCRIPTION="Secure x402 payment facilitator"
PORT=80
HTTPS_PORT=443
USE_HTTPS=false
NODE_ENV=production

# SSL Configuration (optional, for direct HTTPS)
SSL_CERT_PATH=/etc/letsencrypt/live/api.yourdomain.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/api.yourdomain.com/privkey.pem

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=x402_facilitator
DB_USER=x402_user
DB_PASSWORD=your-secure-database-password
DB_CONNECTION_LIMIT=10

# Redis Configuration (optional but recommended for caching)
REDIS_URL=redis://localhost:6379

# =====================================================
# Network Configuration
# =====================================================
# Separate testnet and mainnet networks
TESTNET_NETWORKS="Base Sepolia,Ethereum Sepolia"
MAINNET_NETWORKS="Base,Ethereum"

# =====================================================
# RPC Endpoints
# =====================================================
# Use WebSocket (wss://) for 2x faster performance
# Falls back to HTTPS automatically if needed

# Testnet RPCs
BASE_SEPOLIA_RPC=wss://base-sepolia.g.alchemy.com/v2/YOUR_API_KEY
ETHEREUM_SEPOLIA_RPC=wss://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Mainnet RPCs
BASE_RPC=wss://base-mainnet.g.alchemy.com/v2/YOUR_API_KEY
ETHEREUM_RPC=wss://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY


# =====================================================
# Paymaster Configuration
# =====================================================
# Multi-paymaster support
# At least one is required, others are optional
PAYMASTER_PRIVATE_KEYS=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# =====================================================
# Rate Limiting
# =====================================================
# Global fallback limits (per-merchant tier limits in database)
RATE_LIMIT_WINDOW_MS=60000             # 1 minute window
RATE_LIMIT_MAX_REQUESTS=100            # General endpoints max requests

# Endpoint-specific rate limits (IP-based fallback)
VERIFY_RATE_LIMIT_WINDOW_MS=60000      # 1 minute window for verify
VERIFY_RATE_LIMIT_MAX=30               # 30 verify requests per minute
SETTLE_RATE_LIMIT_WINDOW_MS=60000      # 1 minute window for settle
SETTLE_RATE_LIMIT_MAX=10               # 10 settle requests per minute

# =====================================================
# Logging
# =====================================================
# Levels: error | warn | info | http | debug
# - error: Critical errors only
# - warn: Warnings + errors
# - info: General info (recommended for production)
# - http: HTTP requests + above
# - debug: Detailed debugging (verbose)
LOG_LEVEL=info

# =====================================================
# Transaction Monitoring
# =====================================================
TRANSACTION_MONITOR_INTERVAL_MS=20000  # Check pending txs every 20 seconds
TRANSACTION_TIMEOUT_MS=300000          # 5 minutes transaction timeout

# =====================================================
# Settlement Configuration
# =====================================================
SETTLEMENT_GAS_LIMIT=200000            # Gas limit for ERC-3009 transfers
SETTLEMENT_TIMEOUT_MS=30000            # Wait up to 30 seconds for confirmation

# =====================================================
# Webhook Configuration
# =====================================================
WEBHOOK_TIMEOUT_MS=5000                # Webhook delivery timeout
WEBHOOK_RETRY_ATTEMPTS=3               # Number of retry attempts
WEBHOOK_RETRY_DELAYS=0,5000,15000      # Retry delays: 0s, 5s, 15s

# =====================================================
# Security Configuration
# =====================================================
SECURITY_BAN_THRESHOLD=10              # Ban IP after this many suspicious requests
SECURITY_BAN_DURATION_MS=3600000       # Ban duration: 1 hour
SECURITY_CLEANUP_INTERVAL_MS=600000    # Clean up old bans every 10 minutes

# =====================================================
# Gas Configuration
# =====================================================
GAS_BUFFER_PERCENTAGE=20               # Add 20% buffer to gas estimates

