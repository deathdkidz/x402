# Server Configuration
SERVICE_NAME="x402 Facilitator"
SERVICE_DESCRIPTION="Secure x402 payment facilitator"
PORT=8080
NODE_ENV=production

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=x402_facilitator
DB_USER=root
DB_PASSWORD=your-database-password

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Blockchain Configuration
SUPPORTED_NETWORKS=base-sepolia,ethereum-sepolia
FACILITATOR_PRIVATE_KEY=your-private-key-here
NETWORK=base-sepolia

# RPC URLs per network
BASE_SEPOLIA_RPC=https://base-sepolia.g.alchemy.com/v2/YOUR_API_KEY
ETHEREUM_SEPOLIA_RPC=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
BSC_TESTNET_RPC=https://bnb-testnet.g.alchemy.com/v2/YOUR_API_KEY

# Rate Limiting (IP-based, fallback limits)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
# Available levels: error, warn, info, http, debug
# - error: Only errors (critical issues)
# - warn: Warnings and errors
# - info: General info, warnings, and errors (recommended for production)
# - http: HTTP requests + above
# - debug: Detailed debugging info (verbose, for development only)
LOG_LEVEL=info
